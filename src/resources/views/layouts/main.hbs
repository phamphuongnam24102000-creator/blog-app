<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">   <!-- (1) -->
  <title>{{#if title}}{{title}} – {{/if}}Blog App</title>
  <link rel="icon" href="/favicon.ico">

  <!-- Áp dụng giao diện sáng/tối đã lưu TRƯỚC khi trang vẽ ra, tránh bị nháy màu -->
  <script>
    try {
      const saved = localStorage.getItem('theme');
      if (saved) document.documentElement.dataset.bsTheme = saved;
    } catch {}
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">  <!-- (2) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/app.css">                                                      <!-- (3) -->
</head>
<body class="d-flex flex-column min-vh-100">
  {{> header}}

  <main class="flex-grow-1">
    {{{body}}}
  </main>

  {{> footer}}

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>  <!-- (4) -->
  <script>
    // Nút đổi giao diện sáng/tối
    document.querySelectorAll('[data-theme-toggle]').forEach(btn => {
      btn.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.bsTheme === 'dark' ? 'light' : 'dark';
        root.dataset.bsTheme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
    });
  </script>
</body>
</html>
