<!-- views/news.hbs -->

<!-- TIÊU ĐỀ TRANG -->
<section class="page-header py-5 mb-4">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-2">
        <li class="breadcrumb-item"><a href="/" class="text-white-50">Trang chủ</a></li>
        <li class="breadcrumb-item active text-white" aria-current="page">Tin tức</li>
      </ol>
    </nav>
    <h1 class="fw-bold text-white mb-1">Tin tức</h1>
    <p class="text-white-50 mb-0">Tất cả {{posts.length}} bài viết, mới nhất ở trên cùng.</p>
  </div>
</section>

<section class="container pb-5">
  <div class="row g-4">
    <div class="col-lg-8">
      <!-- Bộ lọc chuyên mục (giao diện) -->
      <div class="d-flex flex-wrap gap-2 mb-4">
        <button class="btn btn-sm btn-primary rounded-pill">Tất cả</button>
        {{#each categories}}
          <button class="btn btn-sm btn-outline-secondary rounded-pill">{{name}}</button>
        {{/each}}
      </div>

      <!-- Danh sách bài dạng ngang -->
      <div class="d-flex flex-column gap-4">
        {{#each posts}}
          <article class="card post-row border-0 shadow-sm overflow-hidden">
            <div class="row g-0">
              <div class="col-md-4">
                <a href="#" class="d-block h-100 post-thumb">
                  <img src="{{image}}" alt="" loading="lazy" class="w-100 h-100 object-fit-cover">
                </a>
              </div>
              <div class="col-md-8">
                <div class="card-body p-4 d-flex flex-column h-100">
                  <div class="d-flex align-items-center gap-2 mb-2 small">
                    <span class="badge rounded-pill text-bg-primary bg-opacity-10 text-primary">{{category}}</span>
                    <span class="text-body-secondary">{{date}}</span>
                  </div>
                  <h2 class="h5 fw-bold"><a href="#" class="stretched-link text-body">{{title}}</a></h2>
                  <p class="text-body-secondary small flex-grow-1">{{excerpt}}</p>
                  <div class="d-flex align-items-center gap-3 small text-body-secondary">
                    <span class="d-flex align-items-center gap-2">
                      <span class="avatar avatar-sm">{{initial author}}</span>{{author}}
                    </span>
                    <span><i class="bi bi-clock me-1"></i>{{readTime}} phút đọc</span>
                    <span class="ms-auto"><i class="bi bi-eye me-1"></i>{{formatNumber views}}</span>
                  </div>
                </div>
              </div>
            </div>
          </article>
        {{/each}}
      </div>

      <!-- Phân trang (giao diện) -->
      <nav class="mt-5" aria-label="Phân trang">
        <ul class="pagination justify-content-center">
          <li class="page-item disabled"><a class="page-link" href="#"><i class="bi bi-chevron-left"></i></a></li>
          <li class="page-item active"><a class="page-link" href="#">1</a></li>
          <li class="page-item"><a class="page-link" href="#">2</a></li>
          <li class="page-item"><a class="page-link" href="#">3</a></li>
          <li class="page-item"><a class="page-link" href="#"><i class="bi bi-chevron-right"></i></a></li>
        </ul>
      </nav>
    </div>

    <div class="col-lg-4">
      {{> sidebar}}
    </div>
  </div>
</section>
