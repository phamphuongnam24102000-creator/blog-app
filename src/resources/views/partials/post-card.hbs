{{!-- views/partials/post-card.hbs – thẻ bài viết, dùng: {{> post-card}} trong {{#each posts}} --}}
<article class="card post-card h-100 border-0 shadow-sm">
  <a href="#" class="post-thumb ratio ratio-16x9">
    <img src="{{image}}" alt="" loading="lazy" class="card-img-top object-fit-cover">
  </a>
  <div class="card-body d-flex flex-column">
    <span class="badge rounded-pill text-bg-primary bg-opacity-10 text-primary align-self-start mb-2">{{category}}</span>
    <h3 class="h5 card-title fw-bold">
      <a href="#" class="stretched-link text-body">{{title}}</a>
    </h3>
    <p class="card-text text-body-secondary small flex-grow-1">{{excerpt}}</p>
    <div class="d-flex align-items-center gap-2 small text-body-secondary">
      <span class="avatar avatar-sm">{{initial author}}</span>
      <span class="fw-semibold text-body">{{author}}</span>
      <span>·</span>
      <span>{{date}}</span>
      <span class="ms-auto"><i class="bi bi-clock me-1"></i>{{readTime}} phút</span>
    </div>
  </div>
</article>
